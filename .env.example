# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Discord Bot Configuration (server-side only, configure in Secrets)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional Admin Passcode for Management Console Actions
TLC_ADMIN_PASSCODE=

# Supabase PostgreSQL Connection String (server-side only, configure in Secrets)
DATABASE_URL=

# Optional Supabase Storage for Media Uploads (falls back automatically to PostgreSQL media_assets if omitted)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


